{
    "关闭游戏": {
        "action": {
            "type": "StopApp",
            "param": {
                "package": "com.fyf.newslggf"
            }
        },
        "focus": {
            "Node.Action.Starting": "{name} 开始执行",
            "Node.PipelineNode.Failed": {
                "content": "{name} 执行失败",
                "display": [
                    "log",
                    "toast"
                ]
            }
        }
    }
}
